# 内部培训平台 · 生产环境变量
#
# 部署时复制为 /opt/training/conf/training.env 并填入真实值。
#   cp training.env.example /opt/training/conf/training.env
#   chmod 600 /opt/training/conf/training.env
#   chown training:training /opt/training/conf/training.env
#
# 本文件含密码，**不要提交到代码库**（deploy/.gitignore 已排除 training.env）

# ---------- 数据库 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=roncoo_education
DB_USER=roncoo
# 换成强密码，不要沿用本地的 roncoo123456
DB_PASSWORD=

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Redis 也要设密码（redis.conf 里 requirepass），并只监听 127.0.0.1
REDIS_PASSWORD=

# ---------- JWT ----------
# 登录令牌签名密钥。32 位以上随机串，泄露等于任何人都能伪造登录态。
# 生成：openssl rand -base64 48
JWT_SECRET=

# ---------- 文件访问签名 ----------
# 视频等私有文件的防盗链密钥。泄露后签名可被伪造，视频将可被公网直链下载。
# 生成：openssl rand -base64 48
FILE_SIGN_SECRET=
# 播放地址有效期（秒）。必须大于最长的一个视频时长，否则播到一半地址失效。
FILE_SIGN_EXPIRE=7200

# ---------- 服务地址 ----------
# 单机部署保持默认即可；拆分部署时改成各服务实际地址
SVC_SYSTEM=http://127.0.0.1:7710
SVC_USER=http://127.0.0.1:7720
SVC_COURSE=http://127.0.0.1:7730

# ---------- 其他 ----------
LOG_PATH=/opt/training/logs
UPLOAD_MAX_SIZE=2GB
