    <!--
      以下两个查询为二开手写，不是生成的。
      查的是 users 表而不是 team，放在这里是因为它们只服务于班组管理：
      列表页要显示每个班组的在册人数，删除前要挡住「还有员工挂在这个班组下」。
      users 表的 team_id 字段目前只有数据库有、Users 实体还没同步，
      故不能用 UsersExample 走通用查询。员工档案功能会补齐实体，
      到时这两个查询可以考虑收回 UsersDao。
    -->
    <select id="countUsersByTeamId" parameterType="java.lang.Long" resultType="java.lang.Integer">
        select count(*) from users where team_id = #{teamId,jdbcType=BIGINT}
    </select>

    <select id="countUsersByTeamIds" resultType="java.util.Map">
        select team_id as teamId, count(*) as cnt
        from users
        where team_id in
        <foreach collection="teamIds" item="teamId" open="(" separator="," close=")">
            #{teamId}
        </foreach>
